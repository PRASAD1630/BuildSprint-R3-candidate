# Optional LLM configuration. Keep credentials in .env, never in this template.
MODEL_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1

# Local semantic retrieval. The MiniLM ONNX model is downloaded on first use.
VECTOR_ENABLED=true
VECTOR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# VECTOR_INDEX_DIR=./data/vector_store
# FASTEMBED_CACHE_PATH=./data/model_cache

# Set these only when you want hosted model cost estimates.
# MODEL_INPUT_USD_PER_1M=0
# MODEL_OUTPUT_USD_PER_1M=0

# Optional paths
# R3_PACK=.
# WORKMATE_DB=./workmate.sqlite3
